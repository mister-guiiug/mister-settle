# Dérivé de `config/env.manifest.json` — toute variable y est décrite avec son
# rangement (vars / secrets / local), sa phase et son repli.
#
# AUCUNE N'EST OBLIGATOIRE : ce squelette démarre sans configuration, et c'est
# une propriété à conserver. Une app qui exige une variable la déclare
# `required: "prod"` au manifeste ET l'ajoute au `required-env` de son
# `deploy.yml`, qui arrête alors le déploiement au lieu de publier un bundle
# sans backend.

# Point de collecte des erreurs. Absent : l'observabilité se tait.
VITE_SENTRY_DSN=

# Force le backend. Absent : déduit des variables présentes, sinon local.
VITE_BACKEND=

# ── Supabase (facultatif) ────────────────────────────────────────────────────
# Les deux ensemble activent le backend distant ; l'une sans l'autre laisse
# l'application en local. La clé anonyme est PUBLIQUE par conception : elle est
# dans le bundle servi par GitHub Pages, et c'est la RLS qui protège la donnée.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Clé de projet PostHog (`phc_…`), nuage EUROPÉEN — la MÊME pour tout le parc :
# un seul projet, les applications distinguées dedans par `app_name`, que le
# socle déduit du chemin de base. Publique par conception (elle est dans le
# bundle). Absente, le bandeau de consentement ne rend rien et rien n'est
# mesuré — c'est le seul interrupteur.
VITE_POSTHOG_KEY=
