# Engendré par `pwa-env sync` depuis config/env.manifest.json.
# App : mister-settle
# Ne pas éditer à la main : modifier le manifeste, puis relancer sync --write.

# Force le backend au lieu de le déduire des variables présentes.
# Repli : backend local — l'app démarre sans configuration
VITE_BACKEND=

# Clé projet PostHog (nuage EU)
# Repli : absent : pas de mesure ni bandeau
VITE_POSTHOG_KEY=

# Point de collecte des erreurs.
# Repli : l'observabilité se tait, et Sentry n'est pas chargé du tout
VITE_SENTRY_DSN=

# Clé anonyme, publique par conception : c'est la RLS qui protège, pas sa discrétion.
# Repli : backend local
VITE_SUPABASE_ANON_KEY=

# URL du projet Supabase.
# Repli : backend local — la page publique marche sans compte
VITE_SUPABASE_URL=
